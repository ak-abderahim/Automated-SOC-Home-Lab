
<!-- 
DESCRIPTION
Target Path on Server: /var/ossec/etc/rules/local_rules.xml on MySOC-Wazuh
Purpose: Implements custom rule ID 100050 with an alert severity level of 7 to catch user discovery commands (whoami.exe) parsed from Sysmon events. 
-->



<!-- /var/ossec/etc/rules/local_rules.xml -->
<group name="windows,sysmon">

  <!-- Custom Rule to Detect Adversarial Discovery Activity -->
  <rule id="100050" level="7">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image">type="pcre2"?>(?i)whoami\.exe</field>
    <description>Sysmon: 'Whoami' command executed (Possible Discovery)</description>
    <group>windows_process_creation,discovery</group>
  </rule>

</group>
